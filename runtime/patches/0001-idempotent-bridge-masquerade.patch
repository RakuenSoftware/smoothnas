+++ b/internal/lxc/network_nat_integration_test.go
@@ -0,0 +1,51 @@
+package lxc
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"testing"
+)
+
+// Run inside an isolated network namespace with LXC2DOCKER_NETWORK_TEST=1.
+func TestEnsureBridgeNATRemainsBounded(t *testing.T) {
+	if os.Getenv("LXC2DOCKER_NETWORK_TEST") != "1" {
+		t.Skip("requires an isolated root network namespace")
+	}
+	if err := EnsureBridge(); err != nil {
+		t.Fatal(err)
+	}
+	if err := AddPortForward("10.100.0.2", 18080, 8080, "tcp"); err != nil {
+		t.Fatal(err)
+	}
+	for range 10 {
+		if err := EnsureBridge(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	out, err := exec.Command("nft", "-j", "list", "table", "ip", NATTableName).CombinedOutput()
+	if err != nil {
+		t.Fatalf("nft: %s: %v", out, err)
+	}
+	var rules struct {
+		Nftables []struct {
+			Rule *struct {
+				Chain string `json:"chain"`
+			} `json:"rule"`
+		} `json:"nftables"`
+	}
+	if err := json.Unmarshal(out, &rules); err != nil {
+		t.Fatal(err)
+	}
+	counts := map[string]int{}
+	for _, entry := range rules.Nftables {
+		if entry.Rule != nil {
+			counts[entry.Rule.Chain]++
+		}
+	}
+	for chain, want := range map[string]int{"postrouting": 2, "prerouting": 1, "output": 1} {
+		if counts[chain] != want {
+			t.Errorf("%s: %d rules, want %d", chain, counts[chain], want)
+		}
+	}
+}
