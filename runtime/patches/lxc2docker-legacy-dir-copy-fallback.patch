+func (m *Manager) copyLegacyContainerDir(templateName, id string) error {
+	srcDir := filepath.Join(m.lxcPath, templateName)
+	dstDir := filepath.Join(m.lxcPath, id)
+	srcRootfs := filepath.Join(srcDir, "rootfs")
+	if info, err := os.Stat(srcRootfs); err != nil {
+		return fmt.Errorf("stat template rootfs: %w", err)
+	} else if !info.IsDir() {
+		return fmt.Errorf("template rootfs is not a directory: %s", srcRootfs)
+	}
+
+	if err := os.RemoveAll(dstDir); err != nil {
+		return fmt.Errorf("remove partial clone: %w", err)
+	}
+	if err := os.MkdirAll(dstDir, 0o755); err != nil {
+		return fmt.Errorf("mkdir clone dir: %w", err)
+	}
+
+	out, err := exec.Command("rsync",
+		"-aHAX",
+		"--numeric-ids",
+		"--delete",
+		srcDir+string(os.PathSeparator),
+		dstDir+string(os.PathSeparator),
+	).CombinedOutput()
+	if err != nil {
+		os.RemoveAll(dstDir)
+		return fmt.Errorf("rsync template dir: %s: %w", out, err)
+	}
+	if err := rewriteLegacyCloneIdentity(filepath.Join(dstDir, "config"), filepath.Join(dstDir, "rootfs"), id); err != nil {
+		os.RemoveAll(dstDir)
+		return err
+	}
+	return nil
+}
+
+func rewriteLegacyCloneIdentity(configPath, rootfsPath, id string) error {
+	data, err := os.ReadFile(configPath)
+	if err != nil {
+		return fmt.Errorf("read cloned config: %w", err)
+	}
+
+	lines := strings.Split(string(data), "\n")
+	hostname := sanitizeHostname(id)
+	sawRootfs := false
+	sawUTS := false
+	for i, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		switch {
+		case strings.HasPrefix(trimmed, "lxc.rootfs.path"):
+			lines[i] = "lxc.rootfs.path = dir:" + rootfsPath
+			sawRootfs = true
+		case strings.HasPrefix(trimmed, "lxc.uts.name"):
+			lines[i] = "lxc.uts.name = " + hostname
+			sawUTS = true
+		}
+	}
+	if !sawRootfs {
+		lines = append(lines, "lxc.rootfs.path = dir:"+rootfsPath)
+	}
+	if !sawUTS {
+		lines = append(lines, "lxc.uts.name = "+hostname)
+	}
+	if err := os.WriteFile(configPath, []byte(strings.Join(lines, "\n")), 0o644); err != nil {
+		return fmt.Errorf("write cloned config: %w", err)
+	}
+	return nil
+}
+
