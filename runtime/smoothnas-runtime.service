[Unit]
Description=SmoothNAS plugin runtime (LXC2Docker)
Documentation=https://github.com/games-on-whales/LXC2Docker
After=network-online.target tierd-host-init.service
Wants=network-online.target tierd-host-init.service
Before=tierd.service

[Service]
Type=simple
Environment=SMOOTHNAS_RUNTIME_LXCPATH=/var/lib/smoothnas/runtime/lxc
Environment=SMOOTHNAS_RUNTIME_STATEPATH=/var/lib/smoothnas/runtime/state
EnvironmentFile=-/etc/smoothnas/runtime.env
ExecStartPre=/bin/sh -c 'mkdir -p "$SMOOTHNAS_RUNTIME_LXCPATH" "$SMOOTHNAS_RUNTIME_STATEPATH"'
ExecStart=/usr/lib/smoothnas/docker-lxc-daemon \
    --socket=/run/smoothnas-runtime/docker.sock \
    --lxcpath=${SMOOTHNAS_RUNTIME_LXCPATH} \
    --statepath=${SMOOTHNAS_RUNTIME_STATEPATH}
Restart=always
RestartSec=5
TimeoutStopSec=5min
User=root
Group=root
RuntimeDirectory=smoothnas-runtime
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=smoothnas/runtime
StateDirectoryMode=0755
NoNewPrivileges=false
ProtectHome=no
ProtectSystem=no

[Install]
WantedBy=multi-user.target
